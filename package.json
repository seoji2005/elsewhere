{
  "name": "vworld",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets": "node tools/assets.mjs",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "check": "bash tools/check.sh",
    "build:single": "tsc --noEmit && vite build --mode single --configLoader runner",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.170.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
